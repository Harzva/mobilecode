{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilecode.local/cli-hub.schema.json",
  "title": "MobileCode CLI Hub Manifest",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "title",
        "command",
        "category",
        "supportLevel",
        "riskLevel",
        "credentialPolicy",
        "officialSources",
        "install",
        "probe",
        "auth",
        "readOnlyTasks",
        "mutationTasks"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "category": {
          "enum": ["core", "cloud", "deploy", "collaboration", "ai", "package"]
        },
        "supportLevel": {
          "enum": ["supported", "preview", "planned"]
        },
        "riskLevel": {
          "enum": ["low", "medium", "high"]
        },
        "credentialPolicy": {
          "enum": ["none", "secureStorage", "officialBrowser", "external", "forbidden"]
        },
        "officialSources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "install": {
          "type": "object",
          "required": ["strategy", "profileId", "packages"],
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "enum": ["packageProfile", "npmGlobal", "nativeInstaller", "manual"]
            },
            "profileId": {
              "type": ["string", "null"]
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "probe": {
          "type": "object",
          "required": ["taskKind", "safeArgs"],
          "additionalProperties": false,
          "properties": {
            "taskKind": {
              "type": ["string", "null"]
            },
            "safeArgs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "auth": {
          "type": "object",
          "required": ["required", "storage", "notes"],
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "boolean"
            },
            "storage": {
              "enum": ["none", "secureStorage", "officialBrowser", "external"]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "taskKind",
              "payload",
              "requiresApproval"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]+$"
              },
              "label": {
                "type": "string"
              },
              "taskKind": {
                "type": "string"
              },
              "payload": {
                "type": "object",
                "additionalProperties": true
              },
              "requiresApproval": {
                "type": "boolean"
              }
            }
          }
        },
        "readOnlyTasks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          }
        },
        "mutationTasks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          }
        },
        "safetyNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
